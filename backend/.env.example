PORT=3001
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=troque_esta_senha
DB_NAME=nps_system

JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=12h

FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000

# Segurança HTTP/API
SECURITY_JSON_BODY_LIMIT=1mb
SECURITY_URLENCODED_BODY_LIMIT=256kb
SECURITY_GLOBAL_RATE_LIMIT_WINDOW_MS=60000
SECURITY_GLOBAL_RATE_LIMIT_MAX=240
SECURITY_WORKBOOK_MAX_BYTES=10485760
SECURITY_WORKBOOK_MAX_ROWS=5000
SECURITY_STANDBY_ENABLED=true
SECURITY_STANDBY_DURATION_MS=600000
SECURITY_STANDBY_EVENT_WINDOW_MS=120000
SECURITY_STANDBY_IP_THRESHOLD=5
SECURITY_STANDBY_GLOBAL_THRESHOLD=18
SECURITY_CRITICAL_IMMEDIATE_STANDBY=true
SECURITY_IP_BLOCK_DURATION_MS=600000
SECURITY_IP_BLOCK_THRESHOLD=3
SECURITY_STANDBY_PAUSE_JOBS=true
ALLOW_LOCALHOST_ORIGINS=true
ALLOW_ANY_VERCEL_PREVIEW_ORIGIN=false
ALLOWED_VERCEL_PROJECT_SUFFIXES=henriquemartins1987s-projects.vercel.app

MASTER_ADMIN_EMAIL=henrique.martins@grcconsultoria.net.br
MASTER_ADMIN_WHATSAPP=
MASTER_ADMIN_PASSWORD=defina-uma-senha-inicial-forte
APPROVAL_EMAIL=henrique.martins@grcconsultoria.net.br

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Grupo Sorria <contato@grcconsultoria.siteempresarial.com>"
# Use apenas se precisar testar outro remetente autorizado no Resend.
RESEND_FALLBACK_FROM=
INITIAL_PASSWORD_LENGTH=10
REQUIRE_PASSWORD_CHANGE_ON_FIRST_LOGIN=true
APP_BASE_URL=https://meu-sistema-nps.vercel.app/
SMTP_ENABLED=false
PASSWORD_RECOVERY_CODE_EXPIRES_MINUTES=15

# Monitoria Master
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ACCESS_TOKEN=
RAILWAY_PROJECT_ID=
