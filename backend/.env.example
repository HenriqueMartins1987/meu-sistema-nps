WHATSAPP_ENABLED=true
APPOINTMENT_REMINDER_LEAD_HOURS=24
APPOINTMENT_REMINDER_INTERVAL_MINUTES=30
COMPLAINT_REMINDER_INTERVAL_MINUTES=30
COMPLAINT_EXPIRED_REMINDER_INTERVAL_HOURS=6
WEEKLY_DEMAND_REMINDER_ENABLED=true
WEEKLY_DEMAND_REMINDER_INTERVAL_MINUTES=15
# 0=domingo, 1=segunda, 2=terça...
WEEKLY_DEMAND_REMINDER_DAY=1
WEEKLY_DEMAND_REMINDER_HOUR=8
WEEKLY_DEMAND_REMINDER_TIMEZONE=America/Sao_Paulo

# WhatsApp oficial via Twilio. Meta/Webhook foram removidos.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_TEMPLATE_DEMANDA_SID=
TWILIO_TEMPLATE_NPS_SID=
TWILIO_TEMPLATE_TESTE_SID=
# Usado para mensagens operacionais completas, inclusive a nova reclamação detalhada.
TWILIO_TEMPLATE_GENERIC_SID=
# Use "1" se o template da Twilio estiver com {{1}} em vez de {{protocolo}}.
TWILIO_TEMPLATE_PROTOCOL_VARIABLE=1
TWILIO_TEMPLATE_COMPLAINT_LINK_VARIABLE=2
# Use "1" se o template de mensagem geral estiver com {{1}} em vez de {{mensagem}}.
TWILIO_TEMPLATE_MESSAGE_VARIABLE=mensagem
# Broadcast oficial para o "grupo" de reclamações. A Twilio não envia para ID de grupo do WhatsApp;
# liste os participantes separados por vírgula, ponto e vírgula ou linha.
COMPLAINT_WHATSAPP_GROUP_RECIPIENTS=

# WhatsApp Service hospedado na VPS
WHATSAPP_SYSTEM_NOTIFICATIONS_PROVIDER=whatsapp_service
WHATSAPP_API_URL=https://whatsapp.example.com
WHATSAPP_API_KEY=
WHATSAPP_NOTIFICATION_SENDER_PHONE=5562999999999
WHATSAPP_SERVICE_TIMEOUT_MS=25000
WHATSAPP_RECONNECT_ON_COMMS_ERROR=true
WHATSAPP_RECONNECT_SEND_DELAY_MS=3500
WHATSAPP_PHONE_FALLBACK_ENABLED=true

# Robô de enriquecimento de telefones
EXTERNAL_PORTAL_LEVEL1_USERNAME=
EXTERNAL_PORTAL_LEVEL1_PASSWORD=
EXTERNAL_PORTAL_LEVEL2_USERNAME=
EXTERNAL_PORTAL_LEVEL2_PASSWORD=
EXTERNAL_PORTAL_BASE_URL=
ROBOT_HEADLESS=true
ROBOT_TIMEOUT_MS=60000
ROBOT_MAX_ATTEMPTS=3
ROBOT_ENABLE_AUTO_AFTER_UPLOAD=true
WHATSAPP_OPEN_MODE=web
WHATSAPP_DEFAULT_COUNTRY_CODE=55

# Rotas opcionais para adaptação do portal externo
EXTERNAL_PORTAL_LEVEL1_PATH=/login
EXTERNAL_PORTAL_LEVEL2_PATH=/login/secondary
EXTERNAL_PORTAL_SEARCH_PATH=/api/patients/search
